{
    "name": "rt-pt-inspector",
    "description": "RT-PT Inspector — radiographic and penetrant technique-sheet creator (ASTM E1742 / E2698 / E1417)",
    "author": {
        "name": "Amitay Levi",
        "email": "amitay1@gmail.com"
    },
    "private": true,
    "version": "1.0.3",
    "type": "module",
    "scripts": {
        "dev": "tsx watch --clear-screen=false --ignore \"**/*.timestamp-*.mjs\" server/index.ts",
        "build": "vite build",
        "typecheck": "tsc -p tsconfig.rtpt.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo/rtpt.tsbuildinfo",
        "typecheck:legacy": "tsc -p tsconfig.app.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsbuildinfo/legacy-app.tsbuildinfo",
        "start": "node scripts/run-with-env.mjs production tsx server/index.ts",
        "db:push": "drizzle-kit push",
        "license:issue": "node scripts/issue-rtpt-license.cjs",
        "license:key:verify": "node scripts/verify-rtpt-license-key.cjs",
        "update:key:verify": "node scripts/verify-rtpt-update-key.cjs",
        "test": "vitest run && tsx --test server/rtptRoutes.test.ts",
        "smoke:release": "node scripts/release-smoke.cjs",
        "test:watch": "vitest",
        "lint": "node scripts/lint-active.mjs",
        "lint:legacy": "eslint .",
        "preview": "vite preview",
        "electron": "electron electron/main.cjs",
        "electron:dev": "node scripts/run-with-env.mjs development electron electron/main.cjs",
        "electron:build": "npm run build && electron-builder --win",
        "dist:win": "npm run build && electron-builder --win",
        "dist:win:builder": "electron-builder --win",
        "release": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1",
        "release:minor": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1 minor",
        "release:major": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1 major",
        "release:dry": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1 -DryRun",
        "release:upload": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1 -UploadOnly",
        "release:portable": "powershell -ExecutionPolicy Bypass -File ./scripts/release.ps1 -IncludePortable"
    },
    "main": "electron/main.cjs",
    "dependencies": {
