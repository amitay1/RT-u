release/
release*/
release-v*/
release-build/
release-build-*/
out/

# Test coverage
coverage/

# Temp files
*.tmp
*.temp
~$*
tmp/
output/

# Root-level support/export artifacts should stay under docs/archive, logs, or vendor
/build.log
/tmpclaude-*-cwd
/rtpt_inspector_diagnostics_*.json
/rtpt-cards-*.json
/generated-icon.png
/pdf-parse-*.tgz
/licenses/*.json
*.rtpt-license.json
**/rtpt-license-private-key.pem
**/rtpt-license-private-*.pem

# User data (unified storage)
data/
!src/data/
src/data/**
!src/data/quickFillPresets.ts

# Large media files (prevent GitHub 100MB limit errors)
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv
*.webm
marketing/frames*/
marketing/clips*/
marketing/verify_*/

# Standards reference PDFs/docs (local only)
standards/pdfs/*.pdf
standards/pdfs/*.docx
standards/pdfs/*.txt

# Large archives and unrelated content
*.rar
*.zip
*.7z
Captain Hardcore*/

# Windows reserved names (can cause issues)
nul
NUL
con
CON
prn
PRN
aux
AUX

# ── Training-video build artifacts (huge / regeneratable) ──
# Keep tracked: scripts/, scenes.py, brand.py, build_*.py, IMAGE_INDEX.md, step-XX-*.png
# Exclude regeneratable intermediates and raw assets:
training-videos/animations/**/__pycache__/
training-videos/animations/**/media/
training-videos/assets/**/audio/
training-videos/assets/**/tmp_final/
training-videos/assets/**/tmp_segments/
training-videos/assets/**/animations/

# Local agent/CLI tooling caches (not part of the RT-PT product)
.codex/
.playwright-cli/

# RT-PT signing private keys must never enter the repo (they live outside it)
**/update-private-key.pem
**/*-private-key.pem
**/*private*.pem
!**/*public*.pem

# Claude Code scratch worktrees — tool artifacts, never source
.claude/worktrees/
