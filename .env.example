# RT-PT Inspector local configuration
# Use a database dedicated to this product. Do not reuse credentials from
# another application.

NODE_ENV=development
HOST=127.0.0.1
PORT=5000

# Standalone PostgreSQL data store
RTPT_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/rtpt_inspector
RTPT_DATABASE_SSL_MODE=disable

# Local development only. Electron uses its independent local identity.
VITE_RTPT_ENABLE_OFFLINE_MODE=false

# Server hardening
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
LOG_LEVEL=debug

# Optional only when exercising controlled-key flows in a protected checkout.
# RTPT_LICENSE_PUBLIC_KEY_SHA256=
# RTPT_UPDATE_PUBLIC_KEY_SHA256=
