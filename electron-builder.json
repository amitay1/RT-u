{
    "appId": "com.amitay.rtptinspector",
    "productName": "RT-PT Inspector",
    "artifactName": "RTPT-Inspector-Setup-${version}.${ext}",
    "publish": [
        {
            "provider": "github",
            "owner": "amitay1",
            "repo": "RT-u",
            "releaseType": "release"
        }
    ],
    "directories": {
        "output": "release-build"
    },
    "extraMetadata": {
        "main": "electron/main.cjs",
        "type": "commonjs"
    },
    "files": [
        "rtpt-dist/**/*",
        "build/icon.png",
        "!rtpt-dist/standards/MRO/**",
        "electron/rtpt-license-service.cjs",
        "electron/rtpt-license-public-key.pem",
        "electron/update-public-key.pem",
        "electron/**/*",
        "!electron/license-manager.cjs",
        "!electron/**/*private*.pem",
        "!electron/**/*.key",
        "!electron/**/*.p12",
        "!electron/**/*.pfx",
        "!electron/**/*.rtpt-license.json",
        "!electron/**/*.rtpt-license",
        "!electron/**/activation-packages{,/**/*}",
        "!server{,/**/*}",
        "!shared{,/**/*}",
        "!**/node_modules/@jscad{,/**/*}",
        "!**/node_modules/@react-three{,/**/*}",
        "!**/node_modules/{three,three-csg-ts,makerjs,paper,dxf-writer,docx,mammoth,opentype.js,pdfjs-dist}{,/**/*}",
        "package.json"
    ],
    "asarUnpack": [
        "rtpt-dist/**/*"
    ],
    "win": {
        "icon": "public/app.ico",
        "target": [
            {
                "target": "nsis",
                "arch": [
                    "x64"
                ]
            },
            {
                "target": "portable",
                "arch": [
                    "x64"
                ]
            }
        ]
    },
    "nsis": {
        "oneClick": true,
        "allowToChangeInstallationDirectory": false,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "differentialPackage": true,
        "runAfterFinish": true,
        "deleteAppDataOnUninstall": false,
        "perMachine": false,
        "allowElevation": true,
        "artifactName": "RTPT-Inspector-Setup-${version}.${ext}"
    },
    "portable": {
        "artifactName": "RTPT-Inspector-Portable-${version}.${ext}"
    }
}
