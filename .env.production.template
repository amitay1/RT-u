# RT-PT Inspector production configuration
# Copy to a protected deployment secret store, not to source control.
# Every URL, key, database, and storage project must belong exclusively to
# RT-PT Inspector. Never reuse another product's environment file.

NODE_ENV=production
HOST=127.0.0.1
PORT=5000

# Dedicated PostgreSQL database. Certificate verification is the default.
RTPT_DATABASE_URL=postgresql://user:strong-password@db.example.com:5432/rtpt_inspector?sslmode=verify-full
RTPT_DATABASE_SSL_MODE=verify-full

# Accountless local/browser mode. Profiles may use the licensed same-origin
# RT/PT server; no browser user/session provider is configured.
VITE_RTPT_ENABLE_OFFLINE_MODE=false

# Controlled public trust anchors. PEM files are provisioned separately at
# electron/rtpt-license-public-key.pem and electron/update-public-key.pem.
RTPT_LICENSE_PUBLIC_KEY_SHA256=replace-with-approved-64-hex-spki-fingerprint
RTPT_UPDATE_PUBLIC_KEY_SHA256=replace-with-approved-64-hex-spki-fingerprint

# Controlled Windows release environment only.
RTPT_WINDOWS_SIGNER_SHA1=replace-with-approved-40-hex-certificate-thumbprint

# The supported standalone server is loopback-only; authenticated public
# serving is intentionally not implemented.
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

LOG_LEVEL=info
